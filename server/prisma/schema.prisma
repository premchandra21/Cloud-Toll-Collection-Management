generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  OPERATOR
  ADMIN
}

enum VehicleType {
  CAR
  BUS
  TRUCK
  HEAVY_VEHICLE
}

enum WalletTransactionType {
  TOP_UP
  TOLL_DEBIT
  REFUND
  ADJUSTMENT
}

enum TollTransactionStatus {
  SUCCESS
  FAILED
}

enum NotificationType {
  LOW_BALANCE
  TOLL_SUCCESS
  TOLL_FAILED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles      Vehicle[]
  wallet        Wallet?
  notifications Notification[]

  @@map("users")
}

model Vehicle {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  vehicleNumber String      @unique
  vehicleType   VehicleType
  rfidTag       String      @unique
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  tollTransactions TollTransaction[]

  @@index([userId])
  @@map("vehicles")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  walletId      String                @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @db.Decimal(12, 2)
  referenceType String?
  referenceId   String?
  description   String?
  createdAt     DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model TollPlaza {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  location  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates            TollRate[]
  tollTransactions TollTransaction[]

  @@map("toll_plazas")
}

model TollRate {
  id          String      @id @default(uuid()) @db.Uuid
  plazaId     String      @db.Uuid
  vehicleType VehicleType
  amount      Decimal     @db.Decimal(10, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  plaza            TollPlaza         @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  tollTransactions TollTransaction[]

  // The "one ACTIVE rate per plaza + vehicleType" rule is a partial unique
  // index. Prisma cannot express it, so it lives in the raw SQL migration.
  @@index([plazaId, vehicleType])
  @@map("toll_rates")
}

model TollTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique
  vehicleId      String                @db.Uuid
  plazaId        String                @db.Uuid
  rateId         String                @db.Uuid
  amount         Decimal               @db.Decimal(10, 2)
  status         TollTransactionStatus
  failureReason  String?
  processedAt    DateTime              @default(now())
  createdAt      DateTime              @default(now())

  vehicle Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  plaza   TollPlaza @relation(fields: [plazaId], references: [id], onDelete: Restrict)
  rate    TollRate  @relation(fields: [rateId], references: [id], onDelete: Restrict)

  @@index([vehicleId])
  @@index([plazaId])
  @@index([status])
  @@index([createdAt])
  @@map("toll_transactions")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}